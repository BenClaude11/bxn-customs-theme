<article class="container article">
  <h1>{{ article.title }}</h1>
  <p class="article__meta">{{ article.published_at | date: '%B %d, %Y' }}{% if article.author %} &middot; {{ article.author }}{% endif %}</p>
  {% if article.image %}
    <img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.title | escape }}" width="1200" height="{{ 1200 | divided_by: article.image.aspect_ratio }}">
  {% endif %}
  <div class="article__content">{{ article.content }}</div>
</article>

{% schema %}
{ "name": "Article", "settings": [] }
{% endschema %}
