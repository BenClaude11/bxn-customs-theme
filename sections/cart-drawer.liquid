<div class="cart-drawer" id="CartDrawer" aria-hidden="true">
  <div class="cart-drawer__overlay" id="CartDrawerOverlay"></div>
  <div class="cart-drawer__panel" role="dialog" aria-label="Cart">
    <div class="cart-drawer__header">
      <h2>Your cart</h2>
      <button class="cart-drawer__close" id="CartDrawerClose" aria-label="Close cart">
        {% render 'icon-close' %}
      </button>
    </div>

    <div class="cart-drawer__items" id="CartDrawerItems">
      <!-- populated by cart.js -->
    </div>

    <div class="cart-drawer__footer" id="CartDrawerFooter">
      <div class="cart-drawer__subtotal">
        <span>Subtotal</span>
        <span id="CartDrawerSubtotal">{{ cart.total_price | money }}</span>
      </div>
      <p class="cart-drawer__note">Shipping and taxes calculated at checkout.</p>
      <a href="{{ routes.cart_url }}" class="button button--secondary button--full">View cart</a>
      <a href="{{ routes.cart_url }}/checkout" class="button button--primary button--full">Checkout</a>
    </div>
  </div>
</div>
