<div class="shop-carousel" id="shop-all">
  <div class="shop-carousel__inner">
    {% if section.settings.heading != blank %}
      <h2 class="shop-carousel__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="shop-carousel__subheading">{{ section.settings.subheading }}</p>
    {% endif %}

    <div class="shop-carousel__viewport">
      <div class="shop-carousel__track" id="ShopCarouselTrack">
        {% assign sc_collection = collections[section.settings.collection] %}
        {% if sc_collection == blank or sc_collection.products_count == 0 %}
          {% assign sc_collection = collections.all %}
        {% endif %}
        {% assign real_count = 0 %}
        {% capture sc_cards %}
          {% if sc_collection != blank %}
            {% for card_product in sc_collection.products limit: section.settings.products_to_show %}
              {% render 'product-card-carousel', card_product: card_product %}
              {% assign real_count = real_count | plus: 1 %}
            {% endfor %}
          {% endif %}
          {% assign sc_remaining = section.settings.products_to_show | minus: real_count %}
          {% if sc_remaining > 0 %}
            {% for i in (1..sc_remaining) %}
              {% render 'product-card-carousel' %}
            {% endfor %}
          {% endif %}
        {% endcapture %}
        {{ sc_cards }}{{ sc_cards }}{{ sc_cards }}
      </div>
    </div>

    <div class="shop-carousel__advance-row">
      <button type="button" class="shop-carousel__advance" id="ShopCarouselPrev" aria-label="Show previous products">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M15 6l-6 6 6 6"/>
        </svg>
      </button>
      <button type="button" class="shop-carousel__advance" id="ShopCarouselNext" aria-label="Show next products">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M9 6l6 6-6 6"/>
        </svg>
      </button>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shop all carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop all"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Hover a part to preview it, click to open the product page."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave blank to show all products."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Total slots",
      "info": "Your real products fill in first; remaining slots show as \"Coming soon\" placeholders.",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Shop all carousel"
    }
  ]
}
{% endschema %}
