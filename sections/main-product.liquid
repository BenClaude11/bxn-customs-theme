{%- assign current_variant = product.selected_or_first_available_variant -%}
<div class="product container product--gallery-{{ section.settings.gallery_style }}">
  <div class="product__gallery">
    {% if product.media.size > 0 %}
      <div class="product__main-image" id="ProductMainImage">
        <img
          src="{{ current_variant.featured_image | default: product.featured_image | image_url: width: 1100 }}"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          id="ProductMainImageTag"
          width="1100"
          height="{{ 1100 | divided_by: product.featured_image.aspect_ratio }}"
        >
      </div>
      {% if product.media.size > 1 %}
        <div class="product__thumbnails">
          {% for media in product.media %}
            <button
              type="button"
              class="product__thumbnail{% if forloop.first %} is-active{% endif %}"
              data-image-url="{{ media.preview_image | image_url: width: 1100 }}"
              aria-label="Show image {{ forloop.index }}"
            >
              <img src="{{ media.preview_image | image_url: width: 200 }}" alt="" width="76" height="76" loading="lazy">
            </button>
          {% endfor %}
        </div>
      {% endif %}
    {% else %}
      <div class="product__main-image">
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {% endif %}
  </div>

  <div class="product__info">
    <a class="product__back" href="{{ routes.all_products_collection_url }}">&larr; Shop all</a>

    {% if product.type != blank %}
      <p class="product__eyebrow">{{ product.type }}</p>
    {% endif %}

    <h1 class="product__title">{{ product.title }}</h1>

    <p class="product__price" id="ProductPrice">
      <span class="now">{{ current_variant.price | money }}</span>
      {%- if current_variant.compare_at_price > current_variant.price -%}
        {%- assign save_pct = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round -%}
        <span class="was">{{ current_variant.compare_at_price | money }}</span>
        <span class="product__save">Save {{ save_pct }}%</span>
      {%- endif -%}
    </p>
    <p class="product__price-note">Shipping calculated at checkout.</p>

    {% form 'product', product, id: 'ProductForm', class: 'product-form', data-product-url: product.url %}
      <input type="hidden" name="id" value="{{ current_variant.id }}" id="ProductSelectedVariantId">

      {% unless product.has_only_default_variant %}
        {% for option in product.options_with_values %}
          {%- assign selected_label = '' -%}
          {%- capture option_buttons -%}
            {%- for value in option.values -%}
              {%- capture value_text -%}{{ value }}{%- endcapture -%}
              {%- assign option_label = value_text | split: '$' | first | strip -%}
              {%- assign last_char = option_label | slice: -1 -%}
              {%- if last_char == '-' or last_char == '–' or last_char == '(' or last_char == ':' or last_char == '|' or last_char == ',' -%}
                {%- assign option_label = option_label | remove_last: last_char | strip -%}
              {%- endif -%}
              {%- if option_label == blank -%}{%- assign option_label = value_text -%}{%- endif -%}
              {%- if option.selected_value == value -%}{%- assign selected_label = option_label -%}{%- endif -%}
              <button
                type="button"
                class="option-value{% if option.selected_value == value %} is-selected{% endif %}"
                data-option-value="{{ value | escape }}"
                data-option-label="{{ option_label | escape }}"
                aria-pressed="{% if option.selected_value == value %}true{% else %}false{% endif %}"
              >
                {%- render 'option-swatch', label: option_label -%}
                <span>{{ option_label }}</span>
              </button>
            {%- endfor -%}
          {%- endcapture -%}
          <div class="product-form__option">
            <div class="product-form__option-header">
              <span class="product-form__option-label">{{ option.name }}</span>
              <span class="product-form__option-selected" data-selected-label>{{ selected_label }}</span>
            </div>
            <div class="product-form__option-values" data-option-index="{{ forloop.index0 }}" role="group" aria-label="{{ option.name }}">
              {{ option_buttons }}
            </div>
          </div>
        {% endfor %}
      {% endunless %}

      <div class="product-form__buy">
        <div class="quantity-selector">
          <button type="button" class="quantity-selector__btn" id="QuantityDecrease" aria-label="Decrease quantity">&minus;</button>
          <input type="number" name="quantity" id="Quantity" value="1" min="1" class="quantity-selector__input" aria-label="Quantity">
          <button type="button" class="quantity-selector__btn" id="QuantityIncrease" aria-label="Increase quantity">&plus;</button>
        </div>

        <button
          type="submit"
          name="add"
          class="product-form__submit"
          id="AddToCartButton"
          {% unless current_variant.available %}disabled{% endunless %}
        >
          <span id="AddToCartText">
            {% if current_variant.available %}Add to cart{% else %}Sold out{% endif %}
          </span>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
      </div>

      {%- if section.settings.show_dynamic_checkout -%}
        <div class="product-form__dynamic">{{ form | payment_button }}</div>
      {%- endif -%}
    {% endform %}

    <div class="product__trust">
      <p class="product__trust-note">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
        Secure checkout
      </p>
      <div class="product__trust-icons">
        {%- assign trust_icons = 'shopify_pay,apple_pay,google_pay,visa,master,american_express' | split: ',' -%}
        {%- for type in trust_icons -%}
          {{ type | payment_type_svg_tag: class: 'product__pay-icon' }}
        {%- endfor -%}
      </div>
    </div>

    <div class="product__accordions">
      {% if product.description != blank %}
        <details class="product-accordion" open>
          <summary class="product-accordion__summary">Description</summary>
          <div class="product-accordion__body">{{ product.description }}</div>
        </details>
      {% endif %}
      {%- liquid
        assign install_video_raw = product.metafields.custom.install_video.value
        assign install_video = blank
        assign install_video_file_url = ''
        assign install_video_url = product.metafields.custom.install_video_url.value | default: product.metafields.custom.install_video_link.value | append: ''
        if install_video_raw.media_type == 'video'
          assign install_video = install_video_raw
        elsif install_video_raw.url != blank
          assign install_video_file_url = install_video_raw.url
        else
          assign install_video_text = install_video_raw | append: ''
          if install_video_text contains 'http'
            assign install_video_url = install_video_text
          endif
        endif
        assign install_steps = product.metafields.custom.install_steps
        assign youtube_id = ''
        if install_video_url contains 'youtu.be/'
          assign youtube_id = install_video_url | split: 'youtu.be/' | last | split: '?' | first
        elsif install_video_url contains '/shorts/'
          assign youtube_id = install_video_url | split: '/shorts/' | last | split: '?' | first
        elsif install_video_url contains 'v='
          assign youtube_id = install_video_url | split: 'v=' | last | split: '&' | first
        endif
        if youtube_id == blank and install_video_file_url == blank and install_video_url contains '.mp4'
          assign install_video_file_url = install_video_url
        endif
      -%}
      {% if section.settings.show_install %}
        <details class="product-accordion product-install">
          <summary class="product-accordion__summary">{{ section.settings.install_heading | default: 'Installation & safety' | escape }}</summary>
          <div class="product-accordion__body">
            {% if install_video != blank %}
              <div class="product-install__video">
                {{ install_video | video_tag: controls: true, preload: 'metadata', playsinline: true }}
              </div>
            {% elsif install_video_file_url != blank %}
              <div class="product-install__video">
                <video src="{{ install_video_file_url }}" controls preload="metadata" playsinline></video>
              </div>
            {% elsif youtube_id != blank %}
              <div class="product-install__video product-install__video--embed">
                <iframe
                  src="https://www.youtube-nocookie.com/embed/{{ youtube_id | escape }}?rel=0"
                  title="How to install {{ product.title | escape }}"
                  loading="lazy"
                  allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen"
                  allowfullscreen
                ></iframe>
              </div>
            {% endif %}

            {% if install_steps != blank %}
              <div class="product-install__steps">{{ install_steps | metafield_tag }}</div>
            {% endif %}

            {% if section.settings.install_warnings != blank %}
              <div class="product-install__warnings">{{ section.settings.install_warnings }}</div>
            {% endif %}
          </div>
        </details>
      {% endif %}
      <details class="product-accordion">
        <summary class="product-accordion__summary">Shipping &amp; returns</summary>
        <div class="product-accordion__body">
          <ul class="product-accordion__links">
            <li><a href="/policies/shipping-policy">Shipping policy</a></li>
            <li><a href="/policies/refund-policy">Refund policy</a></li>
          </ul>
        </div>
      </details>
    </div>

    {% if current_variant.sku != blank %}
      <p class="product__sku">SKU: <span id="ProductSku">{{ current_variant.sku }}</span></p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Product information",
  "settings": [
    {
      "type": "select",
      "id": "gallery_style",
      "label": "Image background",
      "info": "Light suits photos shot on a white background. Cut-out shows transparent PNGs straight on the page with a soft shadow, no box. Dark suits light-coloured cut-outs.",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "cutout", "label": "Cut-out" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "cutout"
    },
    {
      "type": "header",
      "content": "Installation & safety tab"
    },
    {
      "type": "paragraph",
      "content": "Each product's video and steps come from product metafields: custom.install_video (file, video), custom.install_video_url (URL, YouTube) and custom.install_steps (rich text). Set them up under Settings > Custom data > Products."
    },
    {
      "type": "checkbox",
      "id": "show_install",
      "label": "Show Installation & safety tab",
      "default": true
    },
    {
      "type": "text",
      "id": "install_heading",
      "label": "Tab heading",
      "default": "Installation & safety"
    },
    {
      "type": "richtext",
      "id": "install_warnings",
      "label": "Safety warnings (shown on every product)",
      "default": "<p><strong>Before you install</strong></p><ul><li>Check the product suits your bike before connecting anything.</li><li>Disconnect or switch off the battery before working on the electrical system.</li><li>Never bypass or disable brakes, brake cut-off switches, the BMS, fuses or other safety features.</li><li>Test at low speed in a safe, open area before riding normally.</li><li>If you're not confident, have a qualified e-bike or e-moto technician fit it.</li></ul><p>Fitting this product does not make a bike road legal. Read our <a href=\"/policies/legal-notice\">Legal Notice</a> before riding.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show express checkout button",
      "info": "Shop Pay, Apple Pay or \"Buy it now\", depending on your payment settings.",
      "default": true
    }
  ],
  "blocks": []
}
{% endschema %}
