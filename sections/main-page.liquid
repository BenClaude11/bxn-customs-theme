<div class="container page">
  <h1 class="page__heading">{{ page.title }}</h1>
  {% if page.content != blank %}
    <div class="page__content">
      {{ page.content }}
    </div>
  {% endif %}

  {% if page.handle contains 'contact' or page.template_suffix == 'contact' %}
    {% render 'contact-form' %}
  {% endif %}
</div>

{% schema %}
{
  "name": "Page",
  "settings": []
}
{% endschema %}
