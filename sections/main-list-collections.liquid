<div class="container">
  <h1 class="collection__heading">Shop by collection</h1>
  <div class="collection-grid">
    {% for collection in collections %}
      {% if collection.handle != 'frontpage' or collections.size == 1 %}
        <a href="{{ collection.url }}" class="collection-card">
          {% if collection.featured_image %}
            <img src="{{ collection.featured_image | image_url: width: 600 }}" alt="{{ collection.title | escape }}" width="600" height="{{ 600 | divided_by: collection.featured_image.aspect_ratio }}">
          {% else %}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
          <p>{{ collection.title }}</p>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "List collections",
  "settings": []
}
{% endschema %}
