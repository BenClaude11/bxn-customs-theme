{% if section.blocks.size > 0 %}
  <div class="reviews container">
    <div class="reviews__header">
      {% if section.settings.eyebrow != blank %}
        <p class="reviews__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <div class="reviews__header-row">
        {% if section.settings.heading != blank %}
          <h2 class="reviews__heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.rating != blank %}
          <div class="reviews__rating">
            <span class="reviews__rating-value">{{ section.settings.rating }}</span>
            <span class="reviews__rating-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
            {% if section.settings.rating_count != blank %}
              <span class="reviews__rating-count">{{ section.settings.rating_count }}</span>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="reviews__track">
      {% for block in section.blocks %}
        <div class="review-card" {{ block.shopify_attributes }}>
          {% if block.type == 'video_review' %}
            {% if block.settings.video != blank %}
              <div class="review-card__video">
                {{ block.settings.video | video_tag: controls: true, muted: true }}
              </div>
            {% endif %}
            {% if block.settings.quote != blank %}
              <p class="review-card__quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>
            {% endif %}
          {% else %}
            {% if block.settings.stars != blank %}
              <p class="review-card__stars" aria-hidden="true">{{ block.settings.stars }}</p>
            {% endif %}
            {% if block.settings.body != blank %}
              <p class="review-card__body">{{ block.settings.body }}</p>
            {% endif %}
          {% endif %}
          {% if block.settings.name != blank %}
            <p class="review-card__name">{{ block.settings.name }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Reviews",
  "settings": [
    {
      "type": "paragraph",
      "content": "This section only appears once you add review blocks below. No content ships by default — add your own real reviews here as they come in."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Trusted by riders"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer reviews"
    },
    {
      "type": "text",
      "id": "rating",
      "label": "Average rating",
      "info": "e.g. 4.8. Leave blank to hide the rating summary."
    },
    {
      "type": "text",
      "id": "rating_count",
      "label": "Rating count text",
      "info": "e.g. 12 reviews"
    }
  ],
  "blocks": [
    {
      "type": "video_review",
      "name": "Video review",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        },
        {
          "type": "text",
          "id": "quote",
          "label": "Caption"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer name"
        }
      ]
    },
    {
      "type": "text_review",
      "name": "Text review",
      "settings": [
        {
          "type": "text",
          "id": "stars",
          "label": "Stars",
          "default": "★★★★★"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Review text"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer name"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews",
      "blocks": []
    }
  ]
}
{% endschema %}
