{% layout 'password' %}
<div class="account-page">
  {% if shop.password_message != blank %}
    <p>{{ shop.password_message }}</p>
  {% else %}
    <p>Opening soon.</p>
  {% endif %}

  {% form 'storefront_password' %}
    {% if form.errors %}
      <div class="form-errors" role="alert">{{ form.errors | default_errors }}</div>
    {% endif %}

    <label for="StorefrontPassword">Store password</label>
    <input type="password" name="password" id="StorefrontPassword" autocomplete="current-password" required>

    <button type="submit" class="button button--primary">Enter</button>
  {% endform %}
</div>
