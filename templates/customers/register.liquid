<div class="container account-page">
  <h1>Create account</h1>

  {% form 'create_customer' %}
    {% if form.errors %}
      <div class="form-errors" role="alert">{{ form.errors | default_errors }}</div>
    {% endif %}

    <label for="FirstName">First name</label>
    <input type="text" name="customer[first_name]" id="FirstName" autocomplete="given-name">

    <label for="LastName">Last name</label>
    <input type="text" name="customer[last_name]" id="LastName" autocomplete="family-name">

    <label for="RegisterEmail">Email</label>
    <input type="email" name="customer[email]" id="RegisterEmail" autocomplete="email" required>

    <label for="RegisterPassword">Password</label>
    <input type="password" name="customer[password]" id="RegisterPassword" autocomplete="new-password" required>

    <label class="checkbox-label">
      <input type="checkbox" name="customer[accepts_marketing]" value="1">
      Email me about new products and offers
    </label>

    <button type="submit" class="button button--primary">Create account</button>

    <div class="account-page__links">
      <a href="{{ routes.account_login_url }}">Already have an account? Sign in</a>
    </div>
  {% endform %}
</div>
