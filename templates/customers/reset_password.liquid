<div class="container account-page">
  <h1>Reset your password</h1>
  <p>Enter a new password for {{ email }}.</p>

  {% form 'reset_customer_password' %}
    {% if form.errors %}
      <div class="form-errors" role="alert">{{ form.errors | default_errors }}</div>
    {% endif %}

    <label for="ResetPassword">New password</label>
    <input type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password" required>

    <label for="ResetPasswordConfirm">Confirm password</label>
    <input type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" autocomplete="new-password" required>

    <button type="submit" class="button button--primary">Reset password</button>
  {% endform %}
</div>
